# Frontend Environment Variables
# Copy to .env and fill in the values

# Base URL for deployment in a subdirectory (e.g., /devileye/)
# Leave as / for root deployment
VITE_BASE_URL=/

# API base URL (optional - defaults to /api via Vite proxy in dev, or same-origin in prod)
# VITE_API_URL=https://seudominio.com
