generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  initials  String
  username  String   @unique
  password  String
  role      String   @default("operator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedCases  Case[]          @relation("AssignedCases")
  notes          Note[]
  tasks          Task[]
  queries        Query[]
  attachments    Attachment[]
  timelineEvents TimelineEvent[]
}

model Case {
  id            String   @id @default(cuid())
  ref           String   @unique
  title         String
  status        String   @default("active")
  priority      String   @default("medium")
  risk          String   @default("medium")
  summary       String?
  tags          String   @default("[]")
  closureStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedToId String?
  assignedTo   User?   @relation("AssignedCases", fields: [assignedToId], references: [id])

  profiles         Profile[]
  notes            Note[]
  tasks            Task[]
  queries          Query[]
  attachments      Attachment[]
  timelineEvents   TimelineEvent[]
  organogramLayout OrganogramLayout?
  muralItems       MuralItem[]
}

model Profile {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type           String   @default("person")
  name           String
  aliases        String   @default("[]")
  document       String?
  phones         String   @default("[]")
  emails         String   @default("[]")
  addresses      String   @default("[]")
  classification String   @default("secondary")
  notes          String?
  tags           String   @default("[]")
  links          String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Note {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            String   @default("quick")
  title           String
  content         String
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  pinned          Boolean  @default(false)
  private         Boolean  @default(false)
  linkedProfileId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  status       String   @default("pending")
  priority     String   @default("medium")
  dueDate      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Query {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source          String
  queryType       String
  queryParam      String
  status          String   @default("pending")
  reliability     String?
  resultSummary   String?
  notes           String?
  linkedProfileId String?
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  timestamp       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Attachment {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name            String
  type            String   @default("pdf")
  size            String?
  description     String?
  filePath        String?
  uploadedById    String
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  linkedProfileId String?
  uploadedAt      DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  entityType  String?
  entityId    String?
  timestamp   DateTime @default(now())
}

model OrganogramLayout {
  id        String   @id @default(cuid())
  caseId    String   @unique
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nodes     String   @default("[]")
  edges     String   @default("[]")
  updatedAt DateTime @updatedAt
}

model MuralItem {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String   @default("sticky")
  color     String   @default("general")
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(220)
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
