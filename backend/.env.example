# Banco de dados SQLite (caminho absoluto ou relativo)
DATABASE_URL="file:./prisma/devileye.db"

# Segredo JWT — troque por uma string longa e aleatória em produção!
JWT_SECRET="mude_isso_em_producao_use_algo_longo_e_aleatorio"

# Porta da API
PORT=3001

# URL do frontend (para CORS em produção)
# Em desenvolvimento deixe em branco para aceitar qualquer origem
FRONTEND_URL="https://seudominio.com"

# Pasta de uploads (caminhos relativos são em relação ao CWD do processo)
UPLOADS_DIR="./uploads"
