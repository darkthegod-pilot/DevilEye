# ============================================
# DevilEye Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# Banco de dados SQLite (caminho relativo ao backend/)
DATABASE_URL="file:./prisma/devileye.db"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=production

# CORS — URL do frontend (com barra final)
FRONTEND_URL="https://seudominio.com"

# Diretório de uploads (absoluto ou relativo ao backend/)
UPLOADS_DIR="./uploads"
